    "/v1/admin/applications/{id}": {
      "get": {
        "summary": "Get application details",
        "description": "Retrieves candidate application details, custom question answers, and current hiring stage.",
        "tags": ["Admin Applications"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Application UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Application details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Application" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/admin/applications/{id}/resume": {
      "get": {
        "summary": "Get presigned resume download URL",
        "description": "Generates a time-limited presigned S3 download URL to securely retrieve candidate's resume attachment.",
        "tags": ["Admin Applications"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Application UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned download URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "download_url": {
                      "type": "string",
                      "format": "uri",
                      "example": "https://s3.amazonaws.com/my-bucket/resumes/...?X-Amz-Signature=..."
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "Expiration duration in seconds",
                      "example": 900
                    }
                  },
                  "required": ["download_url", "expires_in"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/admin/applications/{id}/stage": {
      "patch": {
        "summary": "Update application hiring stage",
        "description": "Transitions the candidate through pipeline stages ('applied', 'screening', 'interviewing', 'offer', 'hired', 'rejected'). Triggers webhook notifications.",
        "tags": ["Admin Applications"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Application UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "stage": {
                    "$ref": "#/components/schemas/ApplicationStage"
                  },
                  "rejected_reason": {
                    "type": "string",
                    "description": "Optional reason when stage is rejected",
