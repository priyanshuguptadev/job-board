    "/v1/admin/webhooks": {
      "post": {
        "summary": "Register webhook subscription",
        "description": "Subscribes an HTTPS URL endpoint to receive HMAC-SHA256 signed event payloads for specified event topics.",
        "tags": ["Admin Webhooks"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "target_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Target HTTP/HTTPS webhook listener URL",
                    "example": "https://api.company.com/webhooks/jobboard"
                  },
                  "events": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of subscribed event topics (or '*' for all events)",
                    "example": ["job.published", "application.created", "application.stage_updated"]
                  }
                },
                "required": ["target_url", "events"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook subscription created successfully with generated secret token",
            "headers": {
              "Location": {
                "description": "URI of the created webhook subscription",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebhookSubscription" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "get": {
        "summary": "List webhook subscriptions",
        "description": "Retrieves all registered outbound webhook subscriptions.",
        "tags": ["Admin Webhooks"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "List of webhook subscriptions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "subscriptions": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/WebhookSubscription" }
                    }
                  },
                  "required": ["subscriptions"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/v1/admin/webhooks/{id}": {
      "delete": {
        "summary": "Delete webhook subscription",
        "description": "Removes an existing webhook subscription.",
        "tags": ["Admin Webhooks"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Webhook subscription UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": {
            "description": "Webhook subscription deleted successfully"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/admin/webhooks/{id}/test": {
      "post": {
        "summary": "Trigger test webhook ping",
        "description": "Dispatches an asynchronous test ping event (`webhook.ping`) with valid HMAC-SHA256 signature to verify receiver connectivity.",
        "tags": ["Admin Webhooks"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Webhook subscription UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Test ping event dispatched",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Test webhook triggered" },
                    "event_id": { "type": "string", "example": "evt_01J8N8P0Z04R2G8E9B6R7W8K1L" }
                  },
                  "required": ["message", "event_id"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header",
        "description": "Scoped API Key header (jb_pub_... for Public, jb_sec_... for Admin)"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped API Key bearer token (jb_pub_... for Public, jb_sec_... for Admin)"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, malformed, or invalid API key",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Insufficient permissions or wrong API key scope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "Unique constraint violation or slug collision",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Uploaded file MIME type is unsupported",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ValidationError": {
        "description": "Input payload failed validation rules",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "RateLimitExceeded": {
        "description": "Rate limit RPS or burst exceeded",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "JobStatus": {
        "type": "string",
        "enum": ["draft", "published", "archived"]
      },
      "EmploymentType": {
        "type": "string",
        "enum": ["full_time", "part_time", "contract", "internship"]
      },
      "ApplicationStage": {
        "type": "string",
        "enum": ["applied", "screening", "interviewing", "offer", "hired", "rejected"]
      },
      "CustomField": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "github_url" },
          "label": { "type": "string", "example": "GitHub Profile URL" },
          "type": { "type": "string", "enum": ["text", "number", "boolean", "select", "url"], "example": "url" },
          "required": { "type": "boolean", "example": true },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Options for 'select' field type",
            "example": ["Option 1", "Option 2"]
          }
        },
        "required": ["id", "label", "type", "required"]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string", "example": "staff-backend-engineer" },
          "title": { "type": "string", "example": "Staff Backend Engineer" },
          "department": { "type": "string", "example": "Engineering" },
          "location": { "type": "string", "example": "San Francisco, CA (Hybrid)" },
          "employment_type": { "$ref": "#/components/schemas/EmploymentType" },
          "experience_level": { "type": "string", "nullable": true, "example": "Senior / Staff" },
          "salary_min": { "type": "number", "nullable": true, "example": 160000.00 },
          "salary_max": { "type": "number", "nullable": true, "example": 210000.00 },
          "salary_currency": { "type": "string", "example": "USD" },
          "description_markdown": { "type": "string", "example": "## About the role\nWe are looking for..." },
          "status": { "$ref": "#/components/schemas/JobStatus" },
          "custom_fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CustomField" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "published_at": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": [
          "id", "slug", "title", "department", "location",
          "employment_type", "description_markdown", "status",
          "custom_fields", "created_at", "updated_at"
        ]
      },
      "JobSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string", "example": "staff-backend-engineer" },
          "title": { "type": "string", "example": "Staff Backend Engineer" },
          "department": { "type": "string", "example": "Engineering" },
          "location": { "type": "string", "example": "San Francisco, CA (Hybrid)" },
          "employment_type": { "$ref": "#/components/schemas/EmploymentType" },
          "experience_level": { "type": "string", "nullable": true, "example": "Senior / Staff" },
          "salary_min": { "type": "number", "nullable": true, "example": 160000.00 },
          "salary_max": { "type": "number", "nullable": true, "example": 210000.00 },
          "salary_currency": { "type": "string", "example": "USD" },
          "published_at": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": [
          "id", "slug", "title", "department", "location",
          "employment_type"
        ]
      },
      "CreateJobRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Staff Backend Engineer" },
          "slug": { "type": "string", "description": "Optional custom slug. If omitted, auto-generated from title.", "example": "staff-backend-engineer" },
          "department": { "type": "string", "example": "Engineering" },
          "location": { "type": "string", "example": "San Francisco, CA (Hybrid)" },
          "employment_type": { "$ref": "#/components/schemas/EmploymentType" },
          "experience_level": { "type": "string", "example": "Senior / Staff" },
          "salary_min": { "type": "number", "example": 160000.00 },
          "salary_max": { "type": "number", "example": 210000.00 },
          "salary_currency": { "type": "string", "default": "USD", "example": "USD" },
          "description_markdown": { "type": "string", "example": "## About the role\nWe are looking for a Staff Engineer..." },
          "status": { "$ref": "#/components/schemas/JobStatus", "default": "draft" },
          "custom_fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CustomField" }
          }
        },
        "required": ["title", "department", "location", "description_markdown"]
      },
      "UpdateJobRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "department": { "type": "string" },
          "location": { "type": "string" },
          "employment_type": { "$ref": "#/components/schemas/EmploymentType" },
          "experience_level": { "type": "string" },
          "salary_min": { "type": "number" },
          "salary_max": { "type": "number" },
          "salary_currency": { "type": "string" },
          "description_markdown": { "type": "string" },
          "status": { "$ref": "#/components/schemas/JobStatus" },
          "custom_fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CustomField" }
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "job_id": { "type": "string", "format": "uuid" },
          "candidate_name": { "type": "string", "example": "Jane Doe" },
          "candidate_email": { "type": "string", "format": "email", "example": "jane.doe@example.com" },
          "candidate_phone": { "type": "string", "nullable": true, "example": "+1 555-0199" },
          "linkedin_url": { "type": "string", "format": "uri", "nullable": true, "example": "https://linkedin.com/in/janedoe" },
          "resume_s3_key": { "type": "string", "example": "resumes/8f03c00c-7729-411a-85d0-9964a7818e9d/jane_resume.pdf" },
          "resume_filename": { "type": "string", "example": "jane_resume.pdf" },
          "custom_answers": {
            "type": "object",
            "additionalProperties": true,
            "example": { "years_experience": 5, "github_url": "https://github.com/janedoe" }
          },
          "stage": { "$ref": "#/components/schemas/ApplicationStage" },
          "rejected_reason": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id", "job_id", "candidate_name", "candidate_email",
          "resume_s3_key", "resume_filename", "custom_answers",
          "stage", "created_at", "updated_at"
        ]
      },
      "ApplicationNote": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "application_id": { "type": "string", "format": "uuid" },
          "author_name": { "type": "string", "example": "Sarah Recruiter" },
          "note_text": { "type": "string", "example": "Strong algorithmic background." },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "application_id", "author_name", "note_text", "created_at"]
      },
      "WebhookSubscription": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "target_url": { "type": "string", "format": "uri", "example": "https://api.company.com/webhooks" },
          "secret_token": { "type": "string", "example": "whsec_98f4a6b2c8e1..." },
          "events": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["job.published", "application.created"]
          },
          "is_active": { "type": "boolean", "example": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "target_url", "secret_token", "events", "is_active", "created_at", "updated_at"]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 20 },
          "total_items": { "type": "integer", "example": 45 },
          "total_pages": { "type": "integer", "example": 3 }
        },
        "required": ["page", "limit", "total_items", "total_pages"]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "example": "resume" },
          "issue": { "type": "string", "example": "File exceeds the maximum allowed size of 10MB" }
        },
        "required": ["field", "issue"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR",
                "enum": [
                  "INVALID_API_KEY",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "VALIDATION_ERROR",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "RATE_LIMIT_EXCEEDED",
                  "CONFLICT",
                  "INTERNAL_SERVER_ERROR",
                  "METHOD_NOT_ALLOWED"
                ]
              },
              "message": { "type": "string", "example": "The provided input failed validation checks." },
              "details": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ErrorDetail" }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    }
  }
}
