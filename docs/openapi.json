{
  "openapi": "3.0.3",
  "info": {
    "title": "Job Board API",
    "version": "1.0.0",
    "description": "An open-source, single-tenant, headless Job Board REST API written in Go, backed by PostgreSQL and S3-compatible object storage.",
    "contact": {
      "name": "Job Board API Support"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness and readiness health check",
        "description": "Checks the server status and database connectivity.",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "database": {
                      "type": "string",
                      "example": "connected"
                    }
                  },
                  "required": ["status", "database"]
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable / Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "unhealthy"
                    },
                    "database": {
                      "type": "string",
                      "example": "unreachable"
                    },
                    "error": {
                      "type": "string",
                      "example": "connection refused"
                    }
                  },
                  "required": ["status", "database"]
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/jobs": {
      "get": {
        "summary": "List published jobs",
        "description": "Retrieves a paginated list of published jobs with optional filtering by department, location, and employment type.",
        "tags": ["Public Careers"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department name",
            "schema": { "type": "string" }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Filter by location substring",
            "schema": { "type": "string" }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "Filter by employment type",
            "schema": {
              "$ref": "#/components/schemas/EmploymentType"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default: 1)",
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Items per page (default: 20, max: 100)",
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of published jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/JobSummary"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  },
                  "required": ["data", "pagination"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimitExceeded" }
        }
      }
    },
    "/v1/public/jobs/{slug_or_id}": {
      "get": {
        "summary": "Get published job details",
        "description": "Retrieves the complete details of a published job listing including custom application fields by slug or UUID.",
        "tags": ["Public Careers"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "slug_or_id",
            "in": "path",
            "required": true,
            "description": "Job slug or UUID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details with custom fields schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimitExceeded" }
        }
      }
    },
    "/v1/public/departments": {
      "get": {
        "summary": "List departments",
        "description": "Lists distinct departments that currently have active published job openings.",
        "tags": ["Public Careers"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "List of active department names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "departments": {
                      "type": "array",
                      "items": { "type": "string" },
                      "example": ["Engineering", "Product", "Design"]
                    }
                  },
                  "required": ["departments"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimitExceeded" }
        }
      }
    },
    "/v1/public/jobs/{job_id}/apply": {
      "post": {
        "summary": "Submit candidate application",
        "description": "Submits a candidate application with resume file and dynamic custom question answers for a published job.",
        "tags": ["Public Careers"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "description": "Target job UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "candidate_name": {
                    "type": "string",
                    "description": "Full name of candidate",
                    "example": "Jane Doe"
                  },
                  "candidate_email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address of candidate",
                    "example": "jane.doe@example.com"
                  },
                  "candidate_phone": {
                    "type": "string",
                    "description": "Phone number (optional)",
                    "example": "+1 555-0199"
                  },
                  "linkedin_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "LinkedIn profile URL (optional)",
                    "example": "https://linkedin.com/in/janedoe"
                  },
                  "resume": {
                    "type": "string",
                    "format": "binary",
                    "description": "Resume attachment file (PDF, DOC, DOCX up to 10MB)"
                  },
                  "custom_answers": {
                    "type": "string",
                    "description": "JSON string containing key-value pairs of answers corresponding to job's custom_fields definitions",
                    "example": "{\"years_experience\": 5, \"github_url\": \"https://github.com/janedoe\"}"
                  }
                },
                "required": ["candidate_name", "candidate_email", "resume"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application submitted successfully",
            "headers": {
              "Location": {
                "description": "URI of the created candidate application",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "message": { "type": "string", "example": "Application submitted successfully." }
                  },
                  "required": ["id", "message"]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimitExceeded" }
        }
      }
    },
    "/v1/admin/jobs": {
      "post": {
        "summary": "Create job listing",
        "description": "Creates a new job listing with optional salary range, employment type, and dynamic custom application fields.",
        "tags": ["Admin Jobs"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created successfully",
            "headers": {
              "Location": {
                "description": "URI of the created job",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "get": {
        "summary": "List all jobs (Admin)",
        "description": "Lists all jobs with filtering by status (draft, published, archived), department, and pagination.",
        "tags": ["Admin Jobs"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by job status",
            "schema": { "$ref": "#/components/schemas/JobStatus" }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department",
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default: 1)",
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Items per page (default: 20, max: 100)",
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Job" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  },
                  "required": ["data", "pagination"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/v1/admin/jobs/{id}": {
      "get": {
        "summary": "Get job by ID",
        "description": "Retrieves full details of any job (regardless of status).",
        "tags": ["Admin Jobs"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Job UUID or slug",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Full job details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "summary": "Update job",
        "description": "Updates job metadata, status, salary, custom question schema, or description.",
        "tags": ["Admin Jobs"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Job UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateJobRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated job details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "summary": "Delete or archive job",
        "description": "Deletes the specified job listing.",
        "tags": ["Admin Jobs"],
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Job UUID",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": {
            "description": "Job deleted successfully"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/admin/jobs/{id}/applications": {
