# ==============================================================================
# Job Board API - Environment Configuration Template
# ==============================================================================

# --- Server Configuration ---
SERVER_PORT=8080
SERVER_ENV=development
SERVER_LOG_LEVEL=info
SERVER_CORS_ALLOWED_ORIGINS=*

# --- Rate Limiting (In-Memory Token Bucket per Client IP) ---
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=50

# --- PostgreSQL Database ---
DATABASE_URL=postgres://jobboard:jobboard@localhost:5432/jobboard?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10

# --- S3 Object Storage (AWS S3, MinIO, Cloudflare R2, GCS) ---
# For AWS S3: leave S3_ENDPOINT empty, set S3_FORCE_PATH_STYLE=false
# For MinIO (local): set S3_ENDPOINT=http://localhost:9000, S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_MINUTES=15
